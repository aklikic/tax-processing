         "id": 2,
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus-local"
               },
               "expr": "sum(irate({__name__=~\"kalix_proxy_grpc_requests_total\", kalix_region=~\"$kalix_region|\", kalix_service=~\"$kalix_service\", grpc_method=~\"$grpc_method\", grpc_status_code=\"0\"}[$__rate_interval])) by (kalix_region, kalix_service, grpc_method) OR sum(irate({__name__=~\"kalix_proxy_http_requests_total\", kalix_region=~\"$kalix_region|\", kalix_service=~\"$kalix_service\", http_target=~\"$http_target\", http_status_code=~\"(2|3)..\"}[$__rate_interval])) by (kalix_region, kalix_service, http_target)",
               "legendFormat": "{{kalix_region}} - {{kalix_service}} - {{grpc_method}}{{http_target}}"
            }
         ],
         "title": "successful requests",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "prometheus-local"
