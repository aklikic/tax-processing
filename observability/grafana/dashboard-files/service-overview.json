            "type": "prometheus",
            "uid": "prometheus-local"
         },
         "description": "Rate of successful requests per second (reqs/s) over time, by endpoint.",
         "fieldConfig": {
            "defaults": {
               "unit": "req/s"
            }
         },
         "gridPos": {
            "h": 9,
            "w": 8,
            "x": 0,
            "y": 2
