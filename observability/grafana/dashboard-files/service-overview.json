               "expr": "(\n  sum by (kalix_region, kalix_service, entity_name) (irate(kalix_eventsourced_loaded_events_total{kalix_region=~\"$kalix_region|\", kalix_service=~\"$kalix_service\", entity_name=~\"$event_sourced_entity\"}[$__rate_interval]))\nor\n  0 * sum by (kalix_region, kalix_service, entity_name) ({__name__=~\"kalix_eventsourced_loaded_snapshots_total\",kalix_region=~\"$kalix_region|\", kalix_service=~\"$kalix_service\", entity_name=~\"$event_sourced_entity\"})\n)\n+\n(\n  sum by (kalix_region, kalix_service, entity_name) (irate(kalix_eventsourced_loaded_snapshots_total{kalix_region=~\"$kalix_region|\", kalix_service=~\"$kalix_service\", entity_name=~\"$event_sourced_entity\"}[$__rate_interval]))\nor\n  0 * sum by (kalix_region, kalix_service, entity_name) ({__name__=~\"kalix_eventsourced_loaded_events_total\",kalix_region=~\"$kalix_region|\", kalix_service=~\"$kalix_service\", entity_name=~\"$event_sourced_entity\"})\n)\n",
